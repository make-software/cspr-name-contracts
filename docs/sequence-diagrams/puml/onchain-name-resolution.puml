@startuml
'https://plantuml.com/sequence-diagram

'autonumber
participant "Contract" #lightblue
participant "NameToken"
participant "Resolver"

== On-chain name resolution ==

activate "Contract"
"Contract" -> "NameToken": metadata(name_hash)
"NameToken" -> "Contract": token metadata
Contract -> Contract: check expiry date

group blocktime < expiry date
"Contract" -> Resolver: address_of(name_hash)
Resolver -> Contract: account address for name
end
== ==

deactivate Contract

@enduml
