@startuml
'https://plantuml.com/sequence-diagram

'autonumber
actor "Domain owner"
participant "Controller"
participant "Registrar"
participant "NameToken"
boundary "Events"

== Set resolver ==

"Domain owner" -> Controller: set_resolver(cspr_name,resolver_hash)
activate Controller

Controller -> NameToken: set_token_metadata(name_hash, new_metadata)
activate NameToken
NameToken -> "Events": MetadataUpdated event
NameToken -> Controller
deactivate NameToken
Controller -> "Domain owner"
deactivate Controller

== ==

@enduml
