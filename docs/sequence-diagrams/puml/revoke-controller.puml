@startuml
'https://plantuml.com/sequence-diagram

'autonumber
actor "Registrar admin"
participant "Registrar"

== Revoke controller contract / admin address permissions==

"Registrar admin" -> "Registrar": revoke_role(CONTROLLER_ROLE, package_key)
activate "Registrar"
"Registrar" -> "Registrar": Update ACL
"Registrar" -> "Registrar admin"
deactivate "Registrar"

@enduml
